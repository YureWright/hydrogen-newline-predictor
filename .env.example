# 高德开放平台 Web 服务 Key（https://lbs.amap.com 注册，免费）
# 申请时服务平台选「Web服务」，并勾选服务权限：
#   驾车路线规划（必选）/ 地理编码（推荐）/ 输入提示（推荐）/ 交通态势（可选）
# 配置后：复制本文件为 .env 并填入你的 Key（.env 已被 gitignore，不会提交）
AMAP_KEY=your_amap_web_service_key

# ===== AI 路线评估（DeepSeek，OpenAI 兼容接口）=====
# 必填：AI 评估功能需要
DEEPSEEK_API_KEY=your_deepseek_api_key
# 可选：自定义端点（默认 https://api.deepseek.com）
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 可选：模型名（默认 deepseek-v4-flash）
DEEPSEEK_MODEL=deepseek-v4-flash
